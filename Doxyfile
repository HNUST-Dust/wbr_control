# wbr_control Doxygen configuration

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "wbr_control"
PROJECT_BRIEF          = "基于 Zephyr 的轮腿机器人控制固件"
PROJECT_NUMBER         = "0.1"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = Chinese

INPUT                  = README.md \
                         docs/doxygen_mainpage.md \
                         docs/doxygen_groups.dox \
                         channels \
                         platform \
                         src \
                         debug
FILE_PATTERNS          = *.c *.cc *.cpp *.h *.hpp *.py *.md *.dox
RECURSIVE              = YES
EXCLUDE                = build \
                         test/can_test/build \
                         test/**/build
EXCLUDE_PATTERNS       = */.git/* */__pycache__/* \
                         */build/*
USE_MDFILE_AS_MAINPAGE = docs/doxygen_mainpage.md

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = YES

EXTRACT_ALL            = NO
EXCLUDE_SYMBOLS        = LOG_MODULE_REGISTER \
                         ZBUS_CHAN_DEFINE \
                         RING_BUF_DECLARE \
                         K_SEM_DEFINE \
                         K_MSGQ_DEFINE \
                         __attribute__
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
INTERNAL_DOCS          = YES
CASE_SENSE_NAMES       = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = .
PREDEFINED             = "ZBUS_CHAN_DECLARE(name)=extern int name" \
                         "ZBUS_CHAN_DEFINE(name,type,validator,user_data,observers,init)=" \
                         "RING_BUF_DECLARE(name,size)=" \
                         "LOG_MODULE_REGISTER(name,level)=" \
                         "__attribute__(attributes)=" \
                         "K_THREAD_STACK_MEMBER(name,size)=unsigned char name[size]" \
                         "K_MSGQ_DEFINE(name,msg_size,max_msgs,align)=extern int name" \
                         "K_SEM_DEFINE(name,initial,limit)=extern int name"
SKIP_FUNCTION_MACROS   = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = build/doxygen-warnings.log
QUIET                  = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_DOCBOOK       = NO

HAVE_DOT               = NO
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = YES
GROUP_NESTED_COMPOUNDS = YES
DIRECTORY_GRAPH        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

ALPHABETICAL_INDEX     = YES
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
LAYOUT_FILE            =
