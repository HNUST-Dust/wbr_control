/*
 * UART2 HI91 async DMA RX-timeout test.
 *
 * PC23: UART2_RXD
 * PC24: UART2_TXD
 *
 * RX completion is detected from UART's own RX timeout interrupt; no TRGM/GPTMR
 * idle-detect pin is required.
 */

&uart2 {
	status = "okay";
	current-speed = <921600>;
	interrupts = <33 1>;
	interrupt-names = "uart";
	dmas = <&hdma 2 12>, <&hdma 3 13>;
	dma-names = "rx", "tx";
};

/*
 * Keep UART3 out of the isolated test image so UART2 reception can be checked
 * without remote-input traffic.
 */
&uart3 {
	status = "disabled";
};
