{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "chassis_controller: build",
      "type": "shell",
      "command": "CCACHE_DISABLE=1 ninja -C build/chassis_controller",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "gimbal_controller: build",
      "type": "shell",
      "command": "CCACHE_DISABLE=1 ninja -C build/gimbal_controller",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "WBR_CONTROL: Serial Log (auto)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/serial_log.sh",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "WBR_CONTROL: Serial Log (/dev/cu.usbmodem11402)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/serial_log.sh /dev/cu.usbmodem11402",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "WBR_CONTROL: Serial Log (/dev/cu.usbserial-11301)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/serial_log.sh /dev/cu.usbserial-11301",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
