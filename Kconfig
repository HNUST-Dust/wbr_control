source "Kconfig.zephyr"

menu "wbr_control application options"

config WBR_CONTROL_MODULE_REMOTE_INPUT
	bool "Enable remote_input module"
	default y
	help
	  Enable registering and starting the remote_input module.

config WBR_CONTROL_MODULE_CHASSIS
	bool "Enable chassis module"
	default y
	help
	  Register and start the 1 kHz independent-leg chassis controller.

config WBR_CONTROL_MODULE_REFEREE
	bool "Enable referee module"
	default n
	help
	  Enable registering and starting the referee module.

config WBR_CONTROL_MODULE_OSCILLOSCOPE
	bool "Enable VOFA oscilloscope module"
	default n
	depends on SERIAL
	help
	  Enable the VOFA+ oscilloscope module. The module sends the latest
	  oscilloscope sample over UART0 using the JustFloat protocol.

config WBR_CONTROL_OSCILLOSCOPE_UART_BAUDRATE
	int "VOFA oscilloscope UART baudrate"
	default 921600
	depends on WBR_CONTROL_MODULE_OSCILLOSCOPE
	help
	  UART0 baudrate used by the VOFA+ oscilloscope output.

config WBR_CONTROL_OSCILLOSCOPE_PERIOD_MS
	int "VOFA oscilloscope output period in milliseconds"
	default 10
	depends on WBR_CONTROL_MODULE_OSCILLOSCOPE
	help
	  Output period for the VOFA+ oscilloscope module. A value of 10 ms
	  gives 100 Hz output.

config WBR_CONTROL_MODULE_HI91_IMU
	bool "Enable HI91 IMU module"
	default n
	depends on SERIAL && UART_ASYNC_API
	help
	  Enable the HI91 external IMU module on UART2. The module parses HI91
	  binary frames and publishes the latest IMU sample to channels.

config WBR_CONTROL_HI91_IMU_UART_BAUDRATE
	int "HI91 IMU UART baudrate"
	default 921600
	depends on WBR_CONTROL_MODULE_HI91_IMU
	help
	  UART2 baudrate used by the HI91 external IMU module.

config WBR_CONTROL_HI91_IMU_STRICT_CRC
	bool "Reject HI91 frames with CRC mismatch"
	default n
	depends on WBR_CONTROL_MODULE_HI91_IMU
	help
	  Reject frames that do not match the built-in CRC16 check. Keep this
	  disabled until the exact CRC variant is confirmed from the device
	  manual or captured frames.

config WBR_CONTROL_MODULE_SYS_STATE
	bool "Enable status indicator module"
	default n
	depends on GPIO || PWM
	help
	  Enable registering and starting the system status indicator module.
	  The module supports RGB breathing LED and optional PWM buzzer output.

config WBR_CONTROL_SHELL_MAVLINK_CONTROL
	bool "Enable MAVLink shell control command"
	default n
	depends on SHELL
	help
	  Enable `mavlink on/off/status` shell command. When enabled,
	  MAVLink bytes are received on the same shell UART by using shell bypass.

config WBR_CONTROL_RUNTIME_INIT_CAN
	bool "Initialize CAN dispatch in bootstrap"
	default y
	depends on CAN
	help
	  Enable CAN dispatch initialization during runtime bootstrap.

config WBR_CONTROL_RUNTIME_INIT_USB
	bool "Initialize USB session in bootstrap"
	default n
	depends on CHERRYUSB_DEVICE
	help
	  Enable CherryUSB Vendor Interrupt session initialization during runtime bootstrap.

config WBR_CONTROL_PC_LINK
	bool "Enable PC link protocol over USB"
	default y
	depends on WBR_CONTROL_RUNTIME_INIT_USB
	help
	  Enable the pc_link session worker inside usb_session. The worker
	  assembles the auto-aim telemetry packet from the gimbal/booster/imu/
	  remote_input channels at a fixed rate and parses auto-aim commands
	  received from the PC over USB Vendor Interrupt endpoints.

config WBR_CONTROL_PC_LINK_PERIOD_MS
	int "PC link send period in milliseconds"
	default 1
	depends on WBR_CONTROL_PC_LINK
	help
	  Period at which the pc_link worker publishes the auto-aim state frame.

config WBR_CONTROL_PC_LINK_COMMAND_TIMEOUT_MS
	int "PC link command timeout in milliseconds"
	range 10 5000
	default 100
	depends on WBR_CONTROL_PC_LINK
	help
	  Publish an idle command when no valid PC control frame has been received
	  within this interval. USB reset and disconnect also request an idle command.

config WBR_CONTROL_RUNTIME_INIT_LITTLEFS
	bool "Initialize LittleFS in bootstrap"
	default n
	depends on FILE_SYSTEM_LITTLEFS
	help
	  Enable LittleFS initialization during runtime bootstrap.

endmenu
