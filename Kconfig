source "Kconfig.zephyr"

menu "rm_test application options"

config RM_TEST_MODULE_REMOTE_INPUT
	bool "Enable remote_input module"
	default y
	help
	  Enable registering and starting the remote_input module.

config RM_TEST_MODULE_CHASSIS
	bool "Enable chassis module"
	default y
	help
	  Enable registering and starting the chassis module.

config RM_TEST_MODULE_GIMBAL
	bool "Enable gimbal module"
	default n
	help
	  Enable registering and starting the gimbal module.

config RM_TEST_MODULE_REFEREE
	bool "Enable referee module"
	default n
	help
	  Enable registering and starting the referee module.

config RM_TEST_MODULE_OSCILLOSCOPE
	bool "Enable VOFA oscilloscope module"
	default n
	depends on SERIAL
	help
	  Enable the VOFA+ oscilloscope module. The module sends the latest
	  oscilloscope sample over UART0 using the JustFloat protocol.

config RM_TEST_OSCILLOSCOPE_UART_BAUDRATE
	int "VOFA oscilloscope UART baudrate"
	default 921600
	depends on RM_TEST_MODULE_OSCILLOSCOPE
	help
	  UART0 baudrate used by the VOFA+ oscilloscope output.

config RM_TEST_OSCILLOSCOPE_PERIOD_MS
	int "VOFA oscilloscope output period in milliseconds"
	default 10
	depends on RM_TEST_MODULE_OSCILLOSCOPE
	help
	  Output period for the VOFA+ oscilloscope module. A value of 10 ms
	  gives 100 Hz output.

config RM_TEST_MODULE_HI91_IMU
	bool "Enable HI91 IMU module"
	default n
	depends on SERIAL && UART_ASYNC_API
	help
	  Enable the HI91 external IMU module on UART2. The module parses HI91
	  binary frames and publishes the latest IMU sample to channels.

config RM_TEST_HI91_IMU_UART_BAUDRATE
	int "HI91 IMU UART baudrate"
	default 921600
	depends on RM_TEST_MODULE_HI91_IMU
	help
	  UART2 baudrate used by the HI91 external IMU module.

config RM_TEST_HI91_IMU_STRICT_CRC
	bool "Reject HI91 frames with CRC mismatch"
	default n
	depends on RM_TEST_MODULE_HI91_IMU
	help
	  Reject frames that do not match the built-in CRC16 check. Keep this
	  disabled until the exact CRC variant is confirmed from the device
	  manual or captured frames.

config RM_TEST_MODULE_SYS_STATE
	bool "Enable status indicator module"
	default n
	depends on GPIO || PWM
	help
	  Enable registering and starting the system status indicator module.
	  The module supports RGB breathing LED and optional PWM buzzer output.

config RM_TEST_SHELL_MAVLINK_CONTROL
	bool "Enable MAVLink shell control command"
	default n
	depends on SHELL
	help
	  Enable `mavlink on/off/status` shell command. When enabled,
	  MAVLink bytes are received on the same shell UART by using shell bypass.

config RM_TEST_RUNTIME_INIT_UART
	bool "Initialize UART dispatch in bootstrap"
	default y
	depends on SERIAL
	help
	  Enable UART dispatch initialization during runtime bootstrap.

config RM_TEST_RUNTIME_INIT_CAN
	bool "Initialize CAN dispatch in bootstrap"
	default y
	depends on CAN
	help
	  Enable CAN dispatch initialization during runtime bootstrap.

config RM_TEST_RUNTIME_INIT_USB
	bool "Initialize USB session in bootstrap"
	default n
	depends on CHERRYUSB_DEVICE && CHERRYUSB_DEVICE_CDC_ACM
	help
	  Enable CherryUSB CDC-ACM session initialization during runtime bootstrap.

config RM_TEST_RUNTIME_INIT_LITTLEFS
	bool "Initialize LittleFS in bootstrap"
	default n
	depends on FILE_SYSTEM_LITTLEFS
	help
	  Enable LittleFS initialization during runtime bootstrap.

endmenu
